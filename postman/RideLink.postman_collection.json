{
  "info": {
    "name": "RideLink API Collection",
    "description": "Exercises the four RideLink microservices end-to-end: account registration/login, driver setup, fare estimation, and the full ride lifecycle, plus two negative scenarios. Run folders top-to-bottom against the 'RideLink - Local' environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Accounts",
      "item": [
        {
          "name": "Register Passenger",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountBaseUrl}}/api/accounts/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nimal Perera\",\n  \"email\": \"nimal.passenger@example.com\",\n  \"password\": \"password123\",\n  \"phoneNumber\": \"0771234567\",\n  \"role\": \"PASSENGER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.environment.set('passengerId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Driver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountBaseUrl}}/api/accounts/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Kasun Silva\",\n  \"email\": \"kasun.driver@example.com\",\n  \"password\": \"password123\",\n  \"phoneNumber\": \"0777654321\",\n  \"role\": \"DRIVER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.environment.set('driverUserId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Passenger",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountBaseUrl}}/api/accounts/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nimal.passenger@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('passengerToken', body.token);",
                  "pm.environment.set('passengerId', body.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Driver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountBaseUrl}}/api/accounts/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kasun.driver@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('driverToken', body.token);",
                  "pm.environment.set('driverUserId', body.userId);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Driver Preparation",
      "item": [
        {
          "name": "Create Driver Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{driverBaseUrl}}/api/drivers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{driverUserId}}\",\n  \"licenseNumber\": \"B1234567\",\n  \"vehicle\": { \"make\": \"Toyota\", \"model\": \"Prius\", \"plateNumber\": \"CAB-1234\", \"color\": \"Silver\", \"capacity\": 4 },\n  \"serviceArea\": \"Colombo\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.environment.set('driverProfileId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Set Driver Available",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{driverBaseUrl}}/api/drivers/{{driverProfileId}}/availability",
            "body": {
              "mode": "raw",
              "raw": "{ \"availability\": \"AVAILABLE\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Driver Location",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{driverBaseUrl}}/api/drivers/{{driverProfileId}}/location",
            "body": {
              "mode": "raw",
              "raw": "{ \"lat\": 6.9271, \"lng\": 79.8612 }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Fare Estimate",
      "item": [
        {
          "name": "Estimate Fare",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{fareBaseUrl}}/api/fares/estimate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": \"Negombo Beach\",\n  \"destination\": \"Colombo Fort\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has estimatedFare', () => pm.expect(pm.response.json()).to.have.property('estimatedFare'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Ride Lifecycle (happy path)",
      "item": [
        {
          "name": "Create Ride Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              }
            ],
            "url": "{{rideBaseUrl}}/api/{{passengerId}}/rides",
            "body": {
              "mode": "raw",
              "raw": "{\"pickup\": \"Negombo Beach\", \"destination\": \"Colombo Fort\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Status is ASSIGNED', () => pm.expect(body.status).to.eql('ASSIGNED'));",
                  "pm.environment.set('rideId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Driver Accepts Ride",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{rideBaseUrl}}/api/rides/{{rideId}}/accept"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is ACCEPTED', () => pm.expect(pm.response.json().status).to.eql('ACCEPTED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Driver Starts Ride",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{rideBaseUrl}}/api/rides/{{rideId}}/start"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is IN_PROGRESS', () => pm.expect(pm.response.json().status).to.eql('IN_PROGRESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete Ride (triggers final fare + payment)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{rideBaseUrl}}/api/rides/{{rideId}}/complete",
            "body": {
              "mode": "raw",
              "raw": "{ \"actualDurationMinutes\": 55, \"paymentMethod\": \"SIMULATED_CARD\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is COMPLETED', () => pm.expect(pm.response.json().status).to.eql('COMPLETED'));",
                  "pm.test('Has finalFare', () => pm.expect(pm.response.json()).to.have.property('finalFare'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Payment for Ride",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              }
            ],
            "url": "{{fareBaseUrl}}/api/passenger/{{passengerId}}/payments/ride/{{rideId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Negative Scenarios",
      "item": [
        {
          "name": "No Available Driver (unserved area)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              }
            ],
            "url": "{{rideBaseUrl}}/api/{{passengerId}}/rides",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceArea\": \"Jaffna\",\n  \"pickup\": \"Jaffna Bus Stand\",\n  \"destination\": \"Nallur Kandaswamy Temple\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 (no driver available)', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Status Transition (start before accept)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{rideBaseUrl}}/api/rides/{{rideId}}/start"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 (invalid transition, ride already completed)', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthorised Access (no token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rideBaseUrl}}/api/{{passengerId}}/rides",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401/403 (unauthenticated)', () => pm.expect([401,403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Failed Simulated Payment (amount out of range)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{fareBaseUrl}}/api/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"{{rideId}}\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"amount\": 99999,\n  \"method\": \"SIMULATED_CARD\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 (record created)', () => pm.response.to.have.status(201));",
                  "pm.test('Payment status is FAILED', () => pm.expect(pm.response.json().status).to.eql('FAILED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Driver Cannot Create a Profile For Another User (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{driverBaseUrl}}/api/drivers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"someone-elses-account-id\",\n  \"licenseNumber\": \"B9999999\",\n  \"vehicle\": { \"make\": \"Toyota\", \"model\": \"Corolla\", \"plateNumber\": \"ZZZ-0000\", \"color\": \"Black\", \"capacity\": 4 },\n  \"serviceArea\": \"Colombo\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Passenger Cannot View Another User's Account (negative)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              }
            ],
            "url": "{{accountBaseUrl}}/api/accounts/{{driverUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Passenger Cannot Accept Their Own Ride Request (negative)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              }
            ],
            "url": "{{rideBaseUrl}}/api/rides/{{rideId}}/accept"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 Forbidden (wrong role) or 409/400 (bad state) - never 200', () => pm.expect(pm.response.code).to.not.eql(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Admin (requires manual DB seed first - see README)",
      "description": "There is deliberately no public 'register as admin' endpoint (letting anyone self-register as admin would be a security bug, not a feature). Before running this folder, seed one admin user directly in MongoDB - see the 'Admin bootstrap' section in the root README or docs/ADMIN_SETUP.md. Default seeded credentials assumed below: admin@ridelink.local / admin123.",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountBaseUrl}}/api/accounts/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ridelink.local\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Role is ADMIN', () => pm.expect(pm.response.json().role).to.eql('ADMIN'));",
                  "const body = pm.response.json();",
                  "pm.environment.set('adminToken', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Suspend a Passenger Account",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{accountBaseUrl}}/api/accounts/{{passengerId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"SUSPENDED\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Account is SUSPENDED', () => pm.expect(pm.response.json().status).to.eql('SUSPENDED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Suspended Passenger Cannot Log In (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountBaseUrl}}/api/accounts/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nimal.passenger@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 (account suspended)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reactivate the Passenger Account",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{accountBaseUrl}}/api/accounts/{{passengerId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"ACTIVE\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Account is ACTIVE', () => pm.expect(pm.response.json().status).to.eql('ACTIVE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Non-Admin Cannot Change Status (negative)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              }
            ],
            "url": "{{accountBaseUrl}}/api/accounts/{{passengerId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"SUSPENDED\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 (passenger is not admin)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Deletion rules and role-based APIs (new)",
      "item": [
        {
          "name": "Driver: update location by ADDRESS (no lat/lng)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{driverBaseUrl}}/api/{{driverUserId}}/drivers/{{driverProfileId}}/location",
            "body": {
              "mode": "raw",
              "raw": "{\"address\": \"Galle Face Green, Colombo\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin: delete driver profile (409 if a ride is not completed)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{driverBaseUrl}}/api/admin/drivers/{{driverProfileId}}"
          }
        },
        {
          "name": "Admin: delete Passenger/Driver account (409 if a ride is not completed)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{accountBaseUrl}}/api/admin/accounts/{{passengerId}}"
          }
        },
        {
          "name": "Passenger/Driver: delete MY account (409 if my ride is not completed)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              }
            ],
            "url": "{{accountBaseUrl}}/api/accounts/me"
          }
        },
        {
          "name": "Ride - Admin: list ALL rides",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{rideBaseUrl}}/api/admin/rides"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ride - Admin: cancel (REQUESTED/ASSIGNED/ACCEPTED/IN_PROGRESS only)",
          "request": {
            "method": "PUT",
            "header": [
              {
