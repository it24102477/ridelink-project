# Copy to .env and fill in for local runs. Do NOT commit a real .env file.
# The same JWT_SECRET must be used by all four services.

JWT_SECRET=change-this-super-secret-key-min-32-chars-long

MONGODB_URI_ACCOUNT=mongodb://localhost:27017/ridelink_account
MONGODB_URI_DRIVER=mongodb://localhost:27017/ridelink_driver
MONGODB_URI_RIDE=mongodb://localhost:27017/ridelink_ride
MONGODB_URI_FARE=mongodb://localhost:27017/ridelink_fare

DRIVER_SERVICE_URL=http://localhost:8082
FARE_SERVICE_URL=http://localhost:8084
